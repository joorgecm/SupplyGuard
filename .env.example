# Copy this file to .env and adjust the values.

# PostgreSQL connection string (Neon) used by the API and Alembic.
# Get it from the Neon console (Connection string), then:
#   - change the "postgresql://" prefix to "postgresql+psycopg://" so SQLAlchemy uses the psycopg driver
#   - keep "?sslmode=require" (Neon only accepts encrypted connections)
DATABASE_URL=postgresql+psycopg://user:password@ep-example-123456.eu-central-1.aws.neon.tech/supplyguard?sslmode=require

# Separate database for the tests (e.g. a Neon branch called "test"), same format as above.
# Tests roll back everything they write. If empty, database tests are skipped.
TEST_DATABASE_URL=postgresql+psycopg://user:password@ep-example-test-123456.eu-central-1.aws.neon.tech/supplyguard?sslmode=require

# Secret used to sign the JWT access tokens. Generate a random one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me
# Optional: token lifetime in minutes (default 60)
# ACCESS_TOKEN_EXPIRE_MINUTES=60
